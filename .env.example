# El API se resuelve automaticamente segun el host donde corre la app.
# Ver src/config/api.ts:
#   localhost / 127.0.0.1              -> http://localhost:8101/api
#   testing-storybrand-frontend.*      -> https://testing-storybrand-backapp.bakano.ec/api
#   tequecruncheese.com (produccion)   -> https://tequecrunchesse-backapp.vercel.app/api
#
# No necesitas definir VITE_API_BASE_URL. Descomenta solo si quieres forzar
# un backend distinto en una corrida puntual (ej: UI local contra produccion).
# VITE_API_BASE_URL=https://tequecrunchesse-backapp.vercel.app/api
